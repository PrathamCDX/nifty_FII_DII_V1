# Copy this file to .env and fill in your values.
# Never commit .env — only this template.

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017

# Database name (optional; falls back to the database in MONGODB_URI)
MONGODB_DB=

# --- Google OAuth (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local dev callback URL to register in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google

# Secret used to sign the app's custom 1-day JWT (localStorage token).
# Falls back to AUTH_SECRET when unset. Generate with: openssl rand -base64 32
JWT_SECRET=
